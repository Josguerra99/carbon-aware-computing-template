# URL base del sitio del taller (te la da el facilitador; no levantas ese servidor tú).
MAIN_SERVER_URL=http://192.168.0.100:3915
# Optional: match Pronóstico ?config=level-2 when facilitador allows local level choice
# WORKSHOP_CONFIG_ID=level-2
PORT=3916
TFJS_BACKEND=gpu

# all, or a comma list of dataset ids from the active workshop config.
TRAIN_DATASETS=all

# Refetch train/meta when older than this many ms. 0 = only when configId changes.
HISTORIC_CACHE_TTL_MS=0

# 1 = ignore disk cache for this process and download again.
REFRESH_HISTORIC=0
