MAIN_SERVER_URL=http://127.0.0.1:3915
PORT=3916
TFJS_BACKEND=gpu

# all, or a comma list of dataset ids from the active workshop config.
TRAIN_DATASETS=all

# Refetch train/meta when older than this many ms. 0 = only when configId changes.
HISTORIC_CACHE_TTL_MS=0

# 1 = ignore disk cache for this process and download again.
REFRESH_HISTORIC=0

# --- WSL + GPU (recommended on Windows) ---
# 1) Workshop site on Windows:  cd carbon-aware-computing-website && bun dev
# 2) One-time setup in WSL:     npm run setup:wsl
# 3) Dev (nodemon + GPU):       npm run start:wsl
#
# Flow:
#   WSL team  -> workshop :3915 (MAIN_SERVER_URL) for historic GHI data
#   Browser   -> loads page from :3915, then fetches YOUR forecast from :3916 (proxy -> WSL :3917)
# Register your team at http://127.0.0.1:3915/register before /forecast shows predictions.
#       Same TypeScript (src/workshop/tfNeuralNetwork.ts), tfjs-node-gpu in Linux.

# --- Native Windows (Node 20, no GPU unless CUDA 11 DLLs) ---
# nvm use 20.19.0 && npm run setup:tf && npm run dev:node
